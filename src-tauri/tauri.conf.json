{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fatuos",
  "version": "0.1.0",
  "identifier": "com.fatuos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Fatuos",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "menu",
        "url": "index.html",
        "title": "Fatuos",
        "width": 880,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Pequeños agentes de IA que aparecen junto a tu cursor",
    "longDescription": "Fatuos es un asistente de escritorio: mini personajes que aparecen junto al mouse y resuelven lo que les pidas con modelos locales o tu propia API key.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    }
  }
}
